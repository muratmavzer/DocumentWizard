# İsteğe bağlı: yalnızca OpenAI yanıt motoru için kullanılır.
OPENAI_API_KEY=sk-projenize-ait-anahtar

# İsteğe bağlı ayarlar
BELGEIZ_MODEL=gpt-5.4-mini
BELGEIZ_OLLAMA_MODEL=qwen3:4b-instruct
BELGEIZ_OLLAMA_URL=http://127.0.0.1:11434
BELGEIZ_RETRIEVAL_THRESHOLD=0.18
BELGEIZ_MAX_FILE_MB=20
BELGEIZ_MAX_PDF_PAGES=100
BELGEIZ_MAX_CONTEXT_CHARS=16000
BELGEIZ_OCR_ENABLED=true
BELGEIZ_OCR_RENDER_SCALE=1.20
BELGEIZ_OCR_MAX_IMAGE_SIDE=1400
BELGEIZ_OCR_MIN_TEXT_CHARS=8
